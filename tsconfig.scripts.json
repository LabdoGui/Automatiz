{
  // Usado por scripts executados com tsx fora do Next (ex.: seed de demonstração):
  // "server-only" vira um módulo vazio, como nos testes.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "server-only": ["./tests/support/server-only.ts"]
    }
  }
}
