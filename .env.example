# ─────────────────────────────────────────────────────────────
# VIVA — variáveis de ambiente (copie para .env e preencha)
# Nunca faça commit do arquivo .env com valores reais.
# ─────────────────────────────────────────────────────────────

# Banco PostgreSQL (obrigatório)
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/viva?schema=public"

# Autenticação (obrigatório)
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# URL pública do app (ex.: https://viva.seudominio.com.br)
BETTER_AUTH_URL="http://localhost:3000"

# Assistente com IA (opcional). Sem a chave, o assistente funciona no modo
# "ferramentas do VIVA" (respostas calculadas, sem IA).
ANTHROPIC_API_KEY=""
# Modelo usado pelo assistente (opcional)
VIVA_AI_MODEL="claude-haiku-5-5"
# Limite de mensagens com IA por usuário por hora (opcional)
VIVA_AI_MAX_PER_HOUR="20"

# Contato do encarregado de dados (exibido na política de privacidade)
VIVA_PRIVACY_CONTACT=""

# Desativa telemetria do Next.js
NEXT_TELEMETRY_DISABLED="1"

# Apenas para testes automatizados locais (não use em produção)
# VIVA_DISABLE_AUTH_RATE_LIMIT="1"
