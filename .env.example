# ─────────────────────────────────────────────────────────────
# VIVA — variáveis de ambiente (copie para .env e preencha)
# Nunca faça commit do arquivo .env com valores reais.
# ─────────────────────────────────────────────────────────────

# Banco PostgreSQL (obrigatório)
# ?schema= escolhe o schema (padrão: public). Com outro schema, defina também o
# search_path do usuário do banco: ALTER ROLE usuario SET search_path = meu_schema;
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/viva?schema=public"

# Autenticação (obrigatório)
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# URL pública do app (ex.: https://viva.seudominio.com.br)
BETTER_AUTH_URL="http://localhost:3000"

# Assistente com IA (opcional). Sem a chave, o assistente funciona no modo
# "ferramentas do VIVA" (respostas calculadas, sem IA).
ANTHROPIC_API_KEY=""
# Modelo usado pelo assistente (opcional; padrão: claude-opus-5-5)
VIVA_AI_MODEL="claude-opus-5-5"
# Limite de mensagens com IA por usuário por hora (opcional)
VIVA_AI_MAX_PER_HOUR="20"

# E-mail transacional por SMTP (opcional): recuperação de senha e confirmação de e-mail.
# Funciona com qualquer provedor (Brevo, Resend, Amazon SES, Gmail com senha de app…).
# Sem SMTP_HOST e EMAIL_FROM, esses recursos não aparecem no app.
EMAIL_FROM=""            # ex.: "VIVA <nao-responda@seudominio.com.br>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"      # "true" para a porta 465
SMTP_USER=""
SMTP_PASSWORD=""
# Apenas em desenvolvimento: mostra os e-mails no terminal em vez de enviar.
# EMAIL_TRANSPORT="console"

# Notificações push (opcional, gratuitas). Gere com: npm run push:chaves
# Sem as chaves, os lembretes aparecem apenas dentro do app.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""         # ex.: "mailto:contato@seudominio.com.br"
# Segredo exigido pela rota agendada /api/cron/lembretes (Authorization: Bearer ...)
CRON_SECRET=""

# Dados abertos (gratuitos, sem chave)
# Busca por código de barras no Open Food Facts (ligada por padrão; "off" desliga)
# VIVA_OPEN_FOOD_FACTS="off"
# Preços da comunidade (Open Prices) para hortifrúti a granel; desligado por padrão
# VIVA_OPEN_PRICES="on"

# Contato do encarregado de dados (exibido na política de privacidade)
VIVA_PRIVACY_CONTACT=""

# Desativa telemetria do Next.js
NEXT_TELEMETRY_DISABLED="1"

# Apenas para testes automatizados locais (não use em produção)
# VIVA_DISABLE_AUTH_RATE_LIMIT="1"

# Seed de demonstração (opcional): senha da conta demo@viva.local.
# Sem valor, uma senha aleatória é gerada e exibida no terminal.
# VIVA_DEMO_PASSWORD=""
# O seed de demonstração é bloqueado com NODE_ENV=production, a menos que:
# VIVA_ALLOW_DEMO="1"
